# Copy to .env beside this file and fill both in. `docker compose` reads it from the
# directory it is run from, so run compose from here.

# A Tailscale auth key: https://login.tailscale.com/admin/settings/keys
# Only used to register the device on first boot. Once the `tailscale` volume holds the
# node key it is never read again, so its own expiry does not matter - disabling key
# expiry on the device in the admin console is what keeps the deployment up.
TS_AUTHKEY=tskey-auth-...

# Any long random string; `openssl rand -hex 32` will do. It is the bearer token the
# Update button sends to Watchtower, and the value you enter under
# Settings → Connections → Advanced → Watchtower.
WATCHTOWER_HTTP_API_TOKEN=
