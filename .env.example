# Copy to .env and fill in. Eight lines, all of them required.
#
# This file holds credentials and nothing else. Every other knob - the public URL, the
# spend cap, the import mailbox, the calendar - lives in the database and is edited at
# /settings, so there is exactly one place to look for any given value.

# Postgres. Any string; nothing else reads it.
POSTGRES_PASSWORD=change-me

# Tailscale auth key from https://login.tailscale.com/admin/settings/keys. The stack
# joins your tailnet as `flighter` and is reachable at https://flighter.<tailnet>.ts.net
# from anything else signed in. Nothing is published to the internet.
TS_AUTHKEY=

# FlightAware AeroAPI, Personal tier. https://www.flightaware.com/aeroapi/signup/personal
AEROAPI_KEY=

# Extraction fallback for emails carrying no structured data.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# The iCloud account. One app-specific password from appleid.apple.com (Sign-In and
# Security -> App-Specific Passwords) covers both the mailbox we read and the calendar we
# write, and neither accepts the Apple ID password itself. Changing your Apple ID password
# revokes every app-specific password, so a new one has to be generated here when you do.
# Which mailbox to import from and which calendar to write to are preferences, set at
# /settings.
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# Pushover, which delivers the pushes to your phone. The token belongs to the application
# you register at https://pushover.net/apps/build; the user key is on the dashboard you
# land on after signing in at https://pushover.net.
PUSHOVER_TOKEN=
PUSHOVER_USER_KEY=
