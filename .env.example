# Copy to .env and fill in. Nine lines, and only the last one is optional.
#
# This file holds credentials and nothing else. Every other knob - the public URL, the
# spend cap, the watched folder, the ntfy topic, the calendar - lives in the database and
# is edited at /settings, so there is exactly one place to look for any given value.

# Postgres. Any string; nothing else reads it.
POSTGRES_PASSWORD=change-me

# Tailscale auth key from https://login.tailscale.com/admin/settings/keys. The stack
# joins your tailnet as `flighter` and is reachable at https://flighter.<tailnet>.ts.net
# from anything else signed in. Nothing is published to the internet.
TS_AUTHKEY=

# Where the phone reaches ntfy, which is that same tailnet name on port 8443.
NTFY_BASE_URL=https://flighter.your-tailnet.ts.net:8443

# FlightAware AeroAPI, Personal tier. https://www.flightaware.com/aeroapi/signup/personal
AEROAPI_KEY=

# Extraction fallback for emails carrying no structured data.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# The iCloud mailbox to watch. The password is an app-specific one from
# appleid.apple.com (Sign-In and Security -> App-Specific Passwords), never the Apple ID
# password itself. Changing your Apple ID password revokes every app-specific password,
# so a new one has to be generated here when you do.
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# The Google OAuth client for Calendar; see the README. Authorise it at /settings, which
# mints the refresh token and stores it in the data volume - there is nothing else to
# paste here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only if you put ntfy behind auth of its own.
NTFY_TOKEN=
