# Copy to .env and fill in. Every value is read once at startup.

# The hostname Cloudflare Tunnel publishes. It ends up in calendar entries, push
# notifications and the widget, all of which are opened from a phone that is not on the
# home network, so a LAN address here will not work.
PUBLIC_BASE_URL=https://flights.example.com
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://flights:flights@db:5432/flights
POSTGRES_PASSWORD=change-me

# FlightAware AeroAPI, Personal tier. https://www.flightaware.com/aeroapi/signup/personal
AEROAPI_KEY=
# Polling stops entirely above this month-to-date estimate. The next tier up carries a
# $100/month minimum, so the default leaves a wide margin under the $5 free allowance.
AEROAPI_MONTHLY_CAP_USD=4.00

# Extraction fallback for emails with no structured data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gmail, read-only. Desktop OAuth client; see README.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# A calendar of its own, so a bad sync is undone by deleting one calendar.
# Turn OFF Google Calendar's own "Events from Gmail" or every flight lands twice.
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=
GCAL_CALENDAR_ID=

NTFY_URL=http://ntfy:80
NTFY_TOPIC=
NTFY_TOKEN=

# The only authentication in the system. Generate with: openssl rand -hex 32
WIDGET_TOKEN=

# Cloudflare Tunnel token from the Zero Trust dashboard.
TUNNEL_TOKEN=
